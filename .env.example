# Скопируй этот файл в ".env" и заполни своими данными.
# Файл ".env" НЕ коммитится (см. .gitignore) — храни пароль только в нём.

# База. По умолчанию — файл рядом с проектом: так он запускается без сервера
# БД и без интернета (этого достаточно для демо и проверки).
DATABASE_URL=sqlite:///izolyat.db

# Для сервера — строка подключения к Supabase (Project Settings -> Database ->
# Connection string -> URI). Схему замени на postgresql+psycopg2://. Если
# прямое подключение db.<ref>.supabase.co не коннектится — возьми "Session
# pooler" (порт 5432, логин вида postgres.<ref>).
# Спецсимволы в пароле URL-кодируй: @ -> %40, # -> %23, : -> %3A
# DATABASE_URL=postgresql+psycopg2://postgres.YOUR-REF:ПАРОЛЬ@aws-0-REGION.pooler.supabase.com:5432/postgres

# Секрет для подписи токенов входа — любая длинная случайная строка.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Код приглашения для регистрации сотрудников. Пока он не задан, школу можно
# зарегистрировать прямо из интерфейса — это удобно для локального демо.
# Для любого публичного стенда задай его: тогда форма регистрации школы
# отключается и завести аккаунт можно только по выданному коду.
REGISTRATION_INVITE_CODE=

# Origin'ы, которым разрешён CORS, через запятую. Фронтенд отдаётся этим же
# приложением (тот же origin), поэтому по умолчанию список пуст и middleware
# не подключается вовсе. Заполняй, только если кабинет или страницу опроса
# открывают с другого хоста — например при демо по локальной сети:
# ALLOWED_ORIGINS=http://192.168.1.10:8000
ALLOWED_ORIGINS=
